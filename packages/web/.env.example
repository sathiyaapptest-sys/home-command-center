# Copy to .env (gitignored). If it is missing, OAUTH_* and OWNER_PASSCODE are read from ../mcp-server/.env.
# "aws" = Amazon Translate + Bedrock (needs the AWS profile below); "offline" = keyword router, English only.
ASSISTANT_MODE=offline
AWS_PROFILE=command-center
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Where the MCP server listens (the assistant links to it with the same OAuth flow Alexa uses).
MCP_URL=http://127.0.0.1:4100
PORT=4200
