# Copy to .env (gitignored) and fill in. Never commit real values.
# Public HTTPS origin Alexa reaches (a tunnel URL while developing, a stable URL once deployed). No trailing slash.
PUBLIC_URL=https://your-public-host.example.com
# The OAuth client you give to `alexa-ai configure-account-linking`.
OAUTH_CLIENT_ID=command-center-alexa
OAUTH_CLIENT_SECRET=generate-a-long-random-value
# Typed on the consent page when you link the account in the Alexa app.
OWNER_PASSCODE=choose-a-passcode
# Optional
PORT=4100
BACKEND_URL=http://localhost:4000
# Extra exact redirect URIs (comma-separated); the CLI prints Alexa's official list.
OAUTH_REDIRECT_URIS=
# Extra browser origins allowed to call /mcp (comma-separated), e.g. an MCP inspector. Requests with no Origin header are always fine.
ALLOWED_ORIGINS=
